# Supabase（必填）
# 在 https://supabase.com 创建项目后，从 Project Settings → API 获取
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 登录功能（可选）：需要 anon key + 在 Supabase Auth 中启用 Email OTP
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 模型服务（OpenAI 兼容协议，仅服务端使用；示例为智谱 GLM）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4-flash
